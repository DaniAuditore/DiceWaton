{
  "name": "temp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "security:sast": "semgrep scan --config .semgrep/security.yml --json --output semgrep-report.json",
    "security:secrets": "gitleaks detect --report-format json --report-path gitleaks-report.json --redact --no-git",
    "security:deps": "npm audit --omit=dev --json > deps-report.json || true",
    "security:sanity": "node scripts/security/supabase-sanity-check.mjs && node scripts/security/config-sanity-check.mjs",
    "security:gate": "node scripts/security/aggregate-security-report.mjs && node scripts/security/gate-evaluator.mjs",
    "security:baseline": "npm run security:sast && npm run security:secrets && npm run security:deps && npm run security:sanity && npm run security:gate"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "@tailwindcss/vite": "^4.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "tailwindcss": "^4.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gitleaks": "^1.0.0",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5"
  }
}
